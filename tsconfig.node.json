{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "*.config.ts",
    "src/themes.ts",
    "src/storage.ts",
    "src/product.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ]
  }
}
