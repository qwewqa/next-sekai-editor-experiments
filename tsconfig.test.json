{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "builtin-assets/**/*.mjs",
    "tests/builtin/*.mjs"
  ],
  "exclude": ["tests/design-capture*/**"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "/src/*": [
        "./src/*"
      ],
      "/tests/*": [
        "./tests/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "vite/client",
      "@types/wicg-file-system-access",
      "node"
    ]
  }
}
