{
    "name": "sonolus-next-sekai-editor",
    "version": "0.5.22",
    "private": true,
    "type": "module",
    "imports": {
        "#platform": {
            "native": "./src/platform/native/index.ts",
            "default": "./src/platform/web.ts"
        },
        "#asset-defaults": {
            "native": "./src/preview/assets/defaults.native.ts",
            "default": "./src/preview/assets/defaults.web.ts"
        }
    },
    "scripts": {
        "postinstall": "node scripts/patch-pixi-default-batcher.mjs",
        "fixtures:generated-large": "node scripts/generate-large-chart.mjs",
        "format:gen": "tsx scripts/format-gen.mjs",
        "test": "tsx --test \"tests/{editor,preview,platform,zip,local,builtin,landing}/**/*.test.{ts,mjs}\" tests/licensing.test.mjs",
        "test:browser": "node scripts/test-browser.mjs",
        "test:timing": "playwright test --project=timing --no-deps",
        "test:compatibility": "npm run build && playwright test --config playwright.compatibility.config.ts",
        "test:production": "playwright test --config playwright.production.config.ts",
        "test:release": "node --test tests/release/*.test.mjs",
        "samples:long-history": "playwright test --config playwright.samples.config.ts longHistory",
        "dev": "vite --host",
        "build": "node scripts/check-lyon.mjs && vite build",
        "build:release": "node scripts/build-release.mjs",
        "build:native": "node scripts/build-native.mjs",
        "build:builtin-assets": "tsx scripts/build-builtin-assets.mjs",
        "check:release": "node scripts/check-release.mjs",
        "check:native-bundle": "node scripts/check-native-bundle.mjs",
        "check:builtin-assets": "tsx scripts/build-builtin-assets.mjs --check",
        "refresh:preview-assets": "node scripts/refresh-preview-assets.mjs",
        "check-type": "vue-tsc --build --force",
        "check-lint": "eslint .",
        "check-format": "prettier . --check",
        "build:lyon": "node scripts/build-lyon.mjs",
        "check:lyon": "node scripts/check-lyon.mjs"
    },
    "dependencies": {
        "@breezystack/lamejs": "^1.2.7",
        "@sonolus/core": "~7.15.2",
        "pako": "^3.0.1",
        "pixi.js": "8.22.0",
        "typebox": "^1.3.6",
        "vue": "^3.5.39"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@resvg/resvg-wasm": "2.6.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/node": "^22.20.1",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/tsconfig": "^0.9.1",
        "acorn": "8.17.0",
        "autoprefixer": "^10.5.2",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.7.0",
        "prettier": "^3.9.5",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.13",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.1.4",
        "vue-tsc": "^3.3.7"
    }
}
