{
	admin off
	# Port 80 stays closed, so there is nothing to redirect from.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	# Caddy's own log goes to stderr, then journald. Request errors are not logged at all: their message can
	# hold a socket error with the visitor's address (an upload cut off mid-way). The filter drops the
	# visitor's address and headers from the rest, and the fields that can carry an address: a TLS-ALPN
	# handshake's remote, and a socket error's text.
	log {
		exclude http.log.error
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			remote delete
			remote_addr delete
			error delete
		}
	}
}

{$STATS_HOSTNAME} {
	# Only the collect paths are public. Caddy writes no access log.
	@collect {
		method POST
		path /api/send /api/batch
	}
	@heartbeat {
		method GET
		path /api/heartbeat
	}

	handle @collect {
		# The sender keeps a batch under 32 KB; this cap is four times that.
		request_body {
			max_size 128KB
		}
		reverse_proxy umami:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle @heartbeat {
		reverse_proxy umami:3000
	}
	handle {
		respond 404
	}
}
