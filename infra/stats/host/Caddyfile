{
	admin off
	# Port 80 stays closed, so there is nothing to redirect from.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	# Caddy's own log (to stderr, then journald) records the request behind an error: a failed
	# reverse_proxy while Umami is down, for example. Drop the visitor's address and headers from it, and
	# the fields that can carry an address elsewhere: a TLS-ALPN handshake's remote, and a socket error's text.
	log {
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			remote delete
			remote_addr delete
			error delete
		}
	}
}

{$STATS_HOSTNAME} {
	# Only the collect paths are public. Caddy writes no access log.
	@collect {
		method POST
		path /api/send /api/batch
	}
	@heartbeat {
		method GET
		path /api/heartbeat
	}

	handle @collect {
		# The sender keeps a batch under 32 KB; this cap is four times that.
		request_body {
			max_size 128KB
		}
		reverse_proxy umami:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle @heartbeat {
		reverse_proxy umami:3000
	}
	handle {
		respond 404
	}
}
