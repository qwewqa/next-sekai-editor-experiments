# The built-in sources and outputs are compared byte for byte, so they keep LF under autocrlf.
builtin-assets/** text eol=lf
builtin-assets/**/*.png binary
*.scp binary
# Frozen Formats v1 vectors and the generated table are byte-exact: never converted on checkout.
tests/fixtures/deflate-v1/** -text
tests/fixtures/deflate-v1/*.bin binary
tests/local/records/golden-v1/** -text
tests/local/records/schema-v1/** -text
src/local/records/fields-v1.json text eol=lf
tests/local/nxsp/golden-v1/** -text
*.nxsp binary
tools/fields-v1.json text eol=lf
tests/zip/plan-conformance-v1/** -text

# Shell scripts and units run on Linux.
infra/** text eol=lf
